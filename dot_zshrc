# --- 1. PATHS AND ENVIRONMENT ---
export PATH="$HOME/.local/bin:$PATH"
export LANG=en_US.UTF-8
export EDITOR=nvim

# --- 2. OH MY ZSH SETUP ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="af-magic"

# Custom plugins must be installed under $ZSH/custom/plugins/
plugins=(git fzf z docker docker-compose ollama zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# --- 3. KEYBOARD MODS (Caps to Ctrl) ---
# Linux GNOME/Wayland only; no-op elsewhere
if [[ "$(uname -s)" == "Linux" ]] && [[ -n "$DISPLAY" || -n "$WAYLAND_DISPLAY" ]]; then
  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.input-sources xkb-options "['caps:ctrl_modifier']" >/dev/null 2>&1
  fi
fi

# --- 4. CROSS-OS BINARY HELPERS ---
# Ubuntu packages bat as batcat and fd as fdfind
if command -v bat >/dev/null 2>&1; then
  _BAT=bat
elif command -v batcat >/dev/null 2>&1; then
  _BAT=batcat
else
  _BAT=
fi

if command -v fd >/dev/null 2>&1; then
  _FD=fd
elif command -v fdfind >/dev/null 2>&1; then
  _FD=fdfind
else
  _FD=
fi

# --- 5. ALIASES ---
if command -v lsd >/dev/null 2>&1; then
  alias ls='lsd'
  alias ll='lsd -l --header'
  alias lla='lsd -la --header'
  alias la='lsd -a'
  alias lt='lsd --tree'
else
  alias ls='ls --color=auto'
  alias ll='ls -alF --color=auto'
  alias la='ls -A --color=auto'
fi

alias c='clear'
alias vim='nvim'
alias vi='nvim'

if [[ -n "$_BAT" ]]; then
  alias cat="${_BAT} --paging=never --style=plain"
fi

# Package-manager shortcuts (detected OS)
case "$(uname -s)" in
  Darwin)
    if command -v brew >/dev/null 2>&1; then
      alias update='brew update && brew upgrade'
      alias install='brew install'
    fi
    ;;
  Linux)
    if command -v dnf >/dev/null 2>&1; then
      alias update='sudo dnf upgrade'
      alias install='sudo dnf install'
    elif command -v apt >/dev/null 2>&1; then
      alias update='sudo apt update && sudo apt upgrade'
      alias install='sudo apt install'
    fi
    ;;
esac

# --- 6. FZF CONFIG ---
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border"
if [[ -n "$_FD" ]]; then
  export FZF_DEFAULT_COMMAND="${_FD} . $HOME"
fi
if [[ -n "$_BAT" ]]; then
  export FZF_CTRL_T_OPTS="--preview '${_BAT} --paging=never --color=always --style=numbers {}' --preview-window=right:60%"
fi

# --- 7. HISTORY SETTINGS ---
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_FIND_NO_DUPS

# --- 8. EXTRAS ---
# Auto-activate Python venv if present in cwd
if [ -f ./.venv/bin/activate ]; then
  source ./.venv/bin/activate
fi

# Clear screen on interactive start
[[ $- == *i* ]] && clear
